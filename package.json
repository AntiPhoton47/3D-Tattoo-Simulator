{
  "name": "ink-atlas",
  "version": "1.6.72",
  "private": true,
  "description": "Local-first 3D tattoo placement simulator",
  "scripts": {
    "check": "node scripts/validate-release.mjs",
    "build:bodies": "node scripts/embed-body-payloads.mjs",
